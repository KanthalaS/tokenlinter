{
  "color": {
    "brand": {
      "primary": { "$type": "color", "$value": "#0a7d33" },
      "primary-hover": { "$type": "color", "$value": "{color.brand.primary}" },
      "text-on-primary": { "$type": "color", "$value": "#ffffff" }
    },
    "neutral": {
      "text": { "$type": "color", "$value": "#1f2933" },
      "background": { "$type": "color", "$value": "#ffffff" }
    }
  },
  "spacing": {
    "xs": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "16px" }
  },
  "typography": {
    "font-family": { "$type": "fontFamily", "$value": ["Inter", "system-ui"] },
    "font-weight-bold": { "$type": "fontWeight", "$value": 700 }
  }
}